        "jsCode": "const now = new Date();\nconst pad = (value) => String(value).padStart(2, '0');\nconst localDate = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;\nreturn [{ json: {\n  runId: `fund-${localDate}-scheduled-${Date.now().toString(36)}`,\n} }];"
