      "name": "Read Captures",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const input=$('Validate Status Input').first().json;\nif (!input.valid) return [{json:{...input,response:{ok:false,error:{code:'INVALID_SESSION',message:'Queue status needs a valid conversation and request ID.'}}}}];\nconst scans=$input.all().map((item)=>item.json).filter((row)=>row&&row.scanId&&(!input.bankAccountId||String(row.bankAccountId)===input.bankAccountId));\nscans.sort((a,b)=>Date.parse(String(b.completedAt||0))-Date.parse(String(a.completedAt||0)));\nconst scan=scans[0];\nif (!scan) return [{json:{...input,response:{ok:true,hasCapture:false,usable:false,state:'missing',message:'No browser-observed Xero queue has been captured yet.',nextStep:'Ask the user to run the one-shot Xero capture helper on the relevant reconciliation page.'}}}];\nconst ageMinutes=Math.max(0,(Date.now()-Date.parse(String(scan.completedAt||0)))/60000);\nconst complete=String(scan.complete)==='yes'||scan.complete===true;\nconst reasons=(()=>{try{return JSON.parse(String(scan.blockingReasonsJson||'[]'));}catch{return ['saved blocker details could not be read'];}})();\nconst usable=complete&&ageMinutes<=30&&reasons.length===0;\nconst state=!complete?'incomplete':ageMinutes>30?'stale':'ready';\nreturn [{json:{...input,response:{ok:true,hasCapture:true,usable,state,scanId:String(scan.scanId),bankAccountId:String(scan.bankAccountId),completedAt:String(scan.completedAt),ageMinutes:Number(ageMinutes.toFixed(1)),expectedCount:Number(scan.expectedCount),observedCount:Number(scan.observedCount),captureSourceHash:String(scan.captureSourceHash||''),blockingReasons:reasons,message:usable?'A complete, fresh Xero reconciliation queue is ready for review.':state==='stale'?'The last complete Xero queue capture is more than 30 minutes old.':'The latest Xero queue capture is incomplete and cannot be reviewed.',nextStep:usable?'The review may use only statement lines carrying this scan ID and their saved source hashes.':'Ask the user to start a new one-shot helper and recapture the full queue.'}}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        0
      ],
      "id": "98000110-0000-4000-8000-000000000013",
      "name": "Shape Queue Status"
    },
    {
      "parameters": {
        "jsCode": "const shaped=$input.first().json; const response=shaped.response||{ok:false,error:{message:'No result'}}; return [{json:{occurredAt:new Date().toISOString(),sessionId:shaped.sessionId,requestId:shaped.requestId,toolName:'get_xero_queue_status',proposedInput:JSON.stringify(shaped.proposedInput||{}),result:JSON.stringify(response),error:response.ok===false?String(response.error?.message||'Tool failed'):'',response}}];"
      },
