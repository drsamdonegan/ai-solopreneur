    {
      "parameters": {
        "jsCode": "const scan = $('Validate Scan').first().json;\nconst previous = $input.all().map((item) => item.json).filter((row) => row && row.lineKey && String(row.bankAccountId) === scan.bankAccountId);\nconst currentIds = new Set(scan.rows.map((line) => String(line.statement_line_id)));\nconst capturedAt = scan.completedAt;\nconst lineRows = [];\nif (scan.complete === 'yes') {\n  for (const old of previous) {\n    if (!currentIds.has(String(old.statementLineId))) lineRows.push({...old, active:'no', scanId:scan.scanId, capturedAt});\n  }\n  for (const line of scan.rows) {\n    const id = String(line.statement_line_id);\n    lineRows.push({\n      lineKey: scan.bankAccountId + '|' + id,\n      statementLineId:id, scanId:scan.scanId, bankAccountId:scan.bankAccountId, active:'yes',\n      occurredAt:String(line.date||''), narration:String(line.narration||''), reference:String(line.reference||''),\n      direction:String(line.direction||''), amount:Number(line.amount||0), currency:String(line.currency||''),\n      visibleContact:String(line.contact||''),visibleAccount:String(line.account||''),visibleDescription:String(line.description||''),visibleTaxType:String(line.tax_type||''),visibleEventName:String(line.event_name||''),visibleProjectName:String(line.project_name||''),\n      visibleFieldsJson:JSON.stringify({contact:line.contact||'',account:line.account||'',description:line.description||'',taxType:line.tax_type||'',eventName:line.event_name||'',projectName:line.project_name||''}),\n      uiMode:String(line.ui_mode||'unknown'), matchedXeroTransactionId:String(line.matched_xero_transaction_id||''),\n      sourceHash:String(line.source_hash||''), capturedAt\n    });\n  }\n}\nconst response = {\n  ok:true, scanId:scan.scanId, bankAccountId:scan.bankAccountId, complete:scan.complete==='yes',\n  expectedCount:scan.expectedCount < 0 ? null : scan.expectedCount, observedCount:scan.observedCount,\n  blockingReasons:JSON.parse(scan.blockingReasonsJson||'[]'), recaptureRequired:scan.complete!=='yes',\n  previousQueueDeactivated:scan.complete==='yes', xeroWrites:false, finalMatchOkUntouched:true\n};\nif (!lineRows.length) return [{json:{writeLines:false,response}}];\nreturn lineRows.map((row) => ({json:{...row,writeLines:true,response}}));"
      },
