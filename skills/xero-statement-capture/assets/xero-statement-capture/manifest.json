{
  "manifest_version": 3,
  "name": "Xero Statement Capture",
  "version": "1.0.0",
  "description": "Read-only, one-shot capture and suggestion labels for the Xero reconciliation queue.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://go.xero.com/*",
    "http://127.0.0.1:8461/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Capture Xero reconciliation queue",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://go.xero.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
