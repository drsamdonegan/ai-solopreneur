    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Read Industry only runs when a profile had to be assumed, and reading a node\n// that did not execute throws. Asking for it carelessly meant the search\n// started and then the reply died on the way back out, so an owner with a\n// profile already saved was told the search had failed every single time,\n// while it was in fact running.\nconst fromNode = (name) => { try { return $(name).first().json; } catch { return null; } };\nconst input = $('Check Profile Exists').first().json;\nconst industry = fromNode('Read Industry')?.industry ?? '';\n\nconst lines = [];\n\nif (input.replacing && input.replacing.reason === 'interrupted') {\n  lines.push(`The search before this one stopped ${input.replacing.age} minutes ago without finishing, which usually means the agent restarted while it was working. Nothing was saved from it, so I have started again.`);\n} else if (input.replacing) {\n  lines.push('Starting a fresh search now, as you asked.');\n}\n\nlines.push('I am looking now. It takes a few minutes: I search the official funding sources for this business, open each new program on its own page to check the amount and the dates, and then work out what the criteria say.');\n\nif (input.needsProfile) {\n  const assumed = input.assumptions.slice();\n  if (industry) assumed.unshift(`working in ${industry}`);\n  lines.push(`I did not have a business profile saved, so I have started one: ${assumed.join(', ')}. Tell me any of that is wrong and I will correct it and look again.`);\n}\n\nlines.push('Ask me for it again in a few minutes and I will read it back.');\n\nreturn [{ json: { ...input, industry, response: {\n  ok: true,\n  status: 'started',\n  runId: input.runId,\n  assumedProfile: input.needsProfile === true,\n  assumptions: input.needsProfile ? input.assumptions : [],\n  industry,\n  restarted: input.replacing ? input.replacing.reason : null,\n  message: lines.join(' ')\n} } }];"
      },
