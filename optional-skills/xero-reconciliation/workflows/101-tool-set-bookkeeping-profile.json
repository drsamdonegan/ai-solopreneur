      "id": "97900101-0000-4000-8000-000000000015",
      "name": "Read Existing Profile",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const input = $('Tool Input').first().json;\nconst existingRows = $input.all().map((item) => item.json).filter((row) => row && row.profileId === 'default');\nconst existing = existingRows[0] ?? {};\n\nconst sessionId = typeof input.sessionId === 'string' ? input.sessionId.trim() : '';\nconst requestId = typeof input.requestId === 'string' ? input.requestId.trim() : '';\nconst uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nlet error = null;\nif (!uuidPattern.test(sessionId) || !uuidPattern.test(requestId)) {\n  error = { code: 'INVALID_SESSION', message: 'Saving a bookkeeping profile needs a valid conversation and request ID.' };\n}\n\nconst text = (value, limit) => {\n  const raw = typeof value === 'string' ? value.trim() : '';\n  return raw.slice(0, limit ?? 300);\n};\n\n// A blank field means 'not mentioned this time', never 'erase what I said before'.\nconst keep = (next, previous) => (next === '' || next === null ? (previous ?? '') : next);\n\n// The threshold above which a suggestion is always handed to a person, however\n// obvious it looks. A guessed one is worse than none: it silently decides how\n// much money the agent is willing to be confident about.\nlet neverGuessAbove = existing.neverGuessAbove ?? 0;\nconst rawThreshold = text(input.neverGuessAbove, 20).replace(/[$,\\s]/g, '');\nif (rawThreshold !== '' && !error) {\n  const parsed = Number(rawThreshold);\n  if (!Number.isFinite(parsed) || parsed < 0) {\n    error = { code: 'INVALID_THRESHOLD', message: 'The always-check-with-me amount has to be a positive number of dollars, or left out entirely.' };\n  } else {\n    neverGuessAbove = Math.round(parsed * 100) / 100;\n  }\n}\n\nconst merged = {\n  profileId: 'default',\n  profileSavedAt: new Date().toISOString(),\n  organisationName: keep(text(input.organisationName, 120), existing.organisationName),\n  baseCurrency: keep(text(input.baseCurrency, 8).toUpperCase(), existing.baseCurrency),\n  financialYearEnd: keep(text(input.financialYearEnd, 40), existing.financialYearEnd),\n  commonSuppliers: keep(text(input.commonSuppliers, 1500), existing.commonSuppliers),\n  commonCustomers: keep(text(input.commonCustomers, 1500), existing.commonCustomers),\n  accountCodeNotes: keep(text(input.accountCodeNotes, 2000), existing.accountCodeNotes),\n  gstTreatmentNotes: keep(text(input.gstTreatmentNotes, 1500), existing.gstTreatmentNotes),\n  neverGuessAbove,\n  // Discovered by the review from Xero itself, never typed by a person.\n  tenantId: existing.tenantId ?? '',\n  queueMode: existing.queueMode ?? '',\n};\n\nreturn [{ json: {\n  valid: error === null,\n  sessionId, requestId,\n  proposedInput: { sessionId, requestId, ...Object.fromEntries([\"organisationName\", \"baseCurrency\", \"financialYearEnd\", \"commonSuppliers\", \"commonCustomers\", \"accountCodeNotes\", \"gstTreatmentNotes\", \"neverGuessAbove\"].map((k) => [k, text(input[k], 200)])) },\n  ...merged,\n  ...(error ? { response: { ok: false, error } } : {}),\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -440,
