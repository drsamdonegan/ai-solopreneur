{
  "name": "ai-solopreneur",
  "version": "0.2.0",
  "private": true,
  "description": "Local AI project assistant: a browser chat and a visual n8n agent, run directly with Node.js",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup": "node scripts/local.mjs setup",
    "start": "node scripts/local.mjs start",
    "stop": "node scripts/local.mjs stop",
    "restart": "node scripts/local.mjs restart",
    "status": "node scripts/local.mjs status",
    "diagnose": "node scripts/local.mjs diagnose",
    "preflight": "node scripts/local.mjs preflight",
    "import-workflows": "node scripts/local.mjs import-workflows",
    "sync-skills": "node scripts/local.mjs sync-skills",
    "export-workflows": "node scripts/local.mjs export-workflows",
    "backup": "node scripts/local.mjs backup",
    "reset": "node scripts/local.mjs reset"
  },
  "dependencies": {
    "n8n": "2.30.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": false,
    "@scarf/scarf@1.4.0": false,
    "@sentry/node-cpu-profiler@2.4.2": false,
    "@sentry/node-native-stacktrace@0.5.2": false,
    "agent-browser@0.26.0": false,
    "cpu-features@0.0.10": false,
    "fsevents@2.3.2": false,
    "isolated-vm@6.1.2": true,
    "msgpackr-extract@3.0.4": false,
    "oracledb@6.10.0": false,
    "protobufjs@7.6.5": false,
    "protobufjs@8.0.1": false,
    "sqlite3@5.1.7": true,
    "ssh2@1.15.0": false,
    "ssh2@1.17.0": false
  }
}
