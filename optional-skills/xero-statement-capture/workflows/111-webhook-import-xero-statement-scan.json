    {
      "parameters": {
        "jsCode": "const raw = $json.body ?? $json;\nconst reasons = [];\nconst string = (value) => typeof value === 'string' ? value.trim() : '';\nconst rows = Array.isArray(raw.lines) ? raw.lines : [];\nconst pages = Array.isArray(raw.pages) ? raw.pages : [];\nconst scanId = string(raw.scan_id) || 'invalid-' + Date.now();\nconst bankAccountId = string(raw.bank_account_id);\nconst expected = Number.isInteger(raw.expected_count) && raw.expected_count >= 0 ? raw.expected_count : null;\nconst observed = rows.length;\nif (raw.schema_version !== 1) reasons.push('schema_version must be 1');\nif (!bankAccountId) reasons.push('bank account ID is missing');\nif (!pages.length) reasons.push('page coverage is missing');\nif (expected === null) reasons.push(\"the Xero queue's expected statement count was not visible\");\nif (expected !== null && expected !== observed) reasons.push('expected ' + expected + ' statement lines but observed ' + observed);\nif (Number(raw.observed_count) !== observed) reasons.push('companion observed count disagrees with the payload');\nconst pageCounts = new Set(pages.map((page) => Number(page.page_count)));\nconst pageCount = pageCounts.size === 1 ? [...pageCounts][0] : 0;\nconst pageNumbers = pages.map((page) => Number(page.page_number)).sort((a,b) => a-b);\nif (!Number.isInteger(pageCount) || pageCount < 1 || pageNumbers.join(',') !== Array.from({length:pageCount},(_,i)=>i+1).join(',')) reasons.push('pagination coverage is incomplete');\nif (pages.reduce((sum,page) => sum + Number(page.observed_count || 0), 0) !== observed) reasons.push('page row counts do not equal observed lines');\nif (pages.some((page) => Boolean(page.has_previous) !== (Number(page.page_number)>1) || Boolean(page.has_next) !== (Number(page.page_number)<pageCount))) reasons.push('pagination controls are inconsistent');\nif (string(raw.capture_error)) reasons.push('browser capture failed: ' + string(raw.capture_error));\nconst ids = rows.map((line) => string(line.statement_line_id));\nif (ids.some((id) => !id) || new Set(ids).size !== ids.length) reasons.push('statement line IDs are missing or duplicated');\nif (rows.some((line) => !/^[a-f0-9]{64}$/.test(string(line.source_hash)))) reasons.push('one or more statement source hashes are invalid');\nif (!/^[a-f0-9]{64}$/.test(string(raw.capture_source_hash))) reasons.push('capture source hash is invalid');\nconst complete = reasons.length === 0 && raw.derived_complete === true;\nif (!complete && raw.derived_complete === true && reasons.length === 0) reasons.push('capture was not independently complete');\nconst completedAt = string(raw.completed_at) || new Date().toISOString();\nreturn [{json:{\n  valid: reasons.length === 0,\n  complete: complete ? 'yes' : 'no',\n  scanId,\n  bankAccountId,\n  startedAt: string(raw.started_at) || completedAt,\n  completedAt,\n  expectedCount: expected === null ? -1 : expected,\n  observedCount: observed,\n  layout: string(raw.layout) || 'unknown',\n  blockingReasonsJson: JSON.stringify([...new Set([...(Array.isArray(raw.blocking_reasons)?raw.blocking_reasons.map(string):[]), ...reasons].filter(Boolean))),\n  captureSourceHash: string(raw.capture_source_hash),\n  rows\n}}];"
      },
