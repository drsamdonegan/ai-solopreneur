      ],
      "id": "95550000-0000-4000-8000-000000000017",
      "name": "Start Search In Background",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $('Check Profile Exists').first().json;\n\nreturn [{ json: { ...input, response: {\n  ok: true,\n  status: 'started',\n  runId: input.runId,\n  message: [\n    'I am looking now. It takes a few minutes: I search the official funding sources for this business, open each new program on its own page to check the amount and the dates, and then work out what the criteria say.',\n    'Ask me for it again in a few minutes and I will read it back.',\n  ].join(' '),\n} } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1220,
        -40
      ],
      "id": "95550000-0000-4000-8000-000000000018",
      "name": "Shape Start Result"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const input = $('Validate Start Input').first().json;\nconst response = $json.response ?? { ok: false, error: { code: 'TOOL_FAILED', message: 'The tool did not return a result.' } };\nreturn { json: {\n  occurredAt: new Date().toISOString(),\n  sessionId: input.sessionId,\n  requestId: input.requestId,\n  toolName: 'start_funding_scan',\n  proposedInput: JSON.stringify(input.proposedInput ?? {}),\n  result: JSON.stringify(response),\n  error: response.ok === false ? String(response.error?.message ?? 'Tool failed') : '',\n  response\n} };"
      },
