    {
      "parameters": {
        "jsCode": "const input=$('Validate Progress').first().json;if(!input.valid)return [{json:{...input,shouldUpdate:false}}];\nconst run=$input.all().map((item)=>item.json).find((row)=>row&&String(row.runId)===input.runId&&String(row.companionId)===input.companionId);\nif(!run)return [{json:{...input,shouldUpdate:false,response:{ok:false,error:{code:'RUN_NOT_CLAIMED',message:'This companion did not claim the capture run.'}}}}];\nif(String(run.cancelRequested)==='yes'||String(run.status)==='cancelled')return [{json:{...input,shouldUpdate:false,response:{ok:true,cancelled:true,run_id:input.runId,status:'cancelled'}}}];\nconst terminal=new Set(['ready','failed','cancelled']);\nif(terminal.has(String(run.status||'')))return [{json:{...input,shouldUpdate:false,response:{ok:true,cancelled:String(run.status)==='cancelled',run_id:input.runId,status:String(run.status)}}}];\nif(['reviewing','ready'].includes(input.status))return [{json:{...input,shouldUpdate:false,response:{ok:false,error:{code:'IMPORT_OWNS_REVIEW_STATE',message:'The authenticated CSV import and saved review own reviewing and ready transitions.'}}}}];\nconst rank={preflight:0,opening:1,awaiting_login:2,awaiting_export:3,discovering:4,capturing:4,verifying:5,uploading:6,failed:9,cancelled:9},storedStatus=String(run.status||'preflight'),backward=(rank[input.status]??-1)<(rank[storedStatus]??-1),status=backward?storedStatus:input.status,current=Math.max(Number(run.progressCurrent||0),input.current),total=Math.max(Number(run.progressTotal||0),input.total,current),accounts=Math.max(Number(run.bankAccountsCaptured||0),input.accounts),lines=Math.max(Number(run.statementLinesObserved||0),input.lines),finishedAt=terminal.has(status)?input.updatedAt:'';\nreturn [{json:{...input,previousStatus:storedStatus,status,phase:status,current,total,accounts,lines,shouldUpdate:true,finishedAt}}];"
