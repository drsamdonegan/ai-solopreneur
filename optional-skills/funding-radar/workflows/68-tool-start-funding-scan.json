    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Three branches arrive here and only one of them ran the classify step. A\n// node that did not execute is an error to read in n8n rather than an\n// undefined, so the reference has to be allowed to come back empty.\nconst fromNode = (name) => { try { return $(name).first().json; } catch { return null; } };\nconst input = fromNode('Build Classify Request') ?? $('Check Profile Exists').first().json;\nconst body = $json.body ?? {};\nconst text = (Array.isArray(body.content) ? body.content : [])\n  .filter((b) => b && b.type === 'text').map((b) => String(b.text ?? '')).join('').trim();\nconst industry = Number($json.statusCode) === 200 && text && text.toLowerCase() !== 'unknown'\n  ? text.slice(0, 120) : '';\nreturn [{ json: { ...input, industry } }];"
      },
