    {
      "parameters": {
        "jsCode": "const input=$('Validate Start Input').first().json;\nif(!input.valid)return [{json:{...input,shouldQueue:false}}];\nconst terminal=new Set(['ready','failed','cancelled']);\nconst rows=$input.all().map((item)=>item.json).filter((row)=>row&&String(row.sessionId)===input.sessionId&&!terminal.has(String(row.status)));\nrows.sort((a,b)=>Date.parse(String(b.runUpdatedAt||b.runCreatedAt||0))-Date.parse(String(a.runUpdatedAt||a.runCreatedAt||0)));\nconst sameId=rows.find((row)=>String(row.runId)===input.runId);\nconst live=sameId||rows.find((row)=>{const at=Date.parse(String(row.lastHeartbeatAt||row.runUpdatedAt||row.runCreatedAt||0));return Number.isFinite(at)&&Date.now()-at<60*60000;});\nif(live){const runId=String(live.runId);const state=String(live.status||live.phase||'preflight');const run={runId,source:String(live.source||'agent'),state,note:String(live.progressMessage||'A Xero export is already in progress for this conversation.'),current:Number(live.progressCurrent||0),total:Number(live.progressTotal||6),accountCount:Number(live.bankAccountsCaptured||0),capturedCount:Number(live.statementLinesObserved||0),expectedCount:Number(live.statementLinesObserved||0),createdAt:String(live.runCreatedAt||''),updatedAt:String(live.runUpdatedAt||'')};return [{json:{...input,shouldQueue:false,response:{ok:true,status:'already-running',run,runId,progressUrl:'/api/xero-capture/runs/'+encodeURIComponent(runId)}}}];}\nreturn [{json:{...input,shouldQueue:true,status:'preflight',phase:'preflight',progressCurrent:0,progressTotal:6,progressMessage:'Waiting for the user export helper.',requiresUserLogin:'unknown',companionId:'',claimedAt:'',lastHeartbeatAt:'',bankAccountsExpected:0,bankAccountsCaptured:0,pagesCompleted:0,statementLinesObserved:0,scanIdsJson:'[]',reviewRunId:'',reviewStatus:'not_started',importKey:'',importClaimId:'',cancelRequested:'no',errorCode:'',errorMessage:'',finishedAt:''}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -140,
        0
      ],
      "id": "98000113-0000-4000-8000-000000000013",
      "name": "Decide Start"
