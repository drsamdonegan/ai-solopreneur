    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const input=$('Validate Completion Input').first().json,s=$json.snapshot,response=s&&s.jobId===input.jobId?{ok:true,jobId:s.jobId,domain:s.domain,status:s.status,researchDepth:s.researchDepth,locationCode:s.locationCode,languageCode:s.languageCode,actualCostUsd:s.actualCostUsd,costLimitUsd:s.costLimitUsd,capturedAt:s.capturedAt,componentStatus:s.componentStatus,warnings:s.warnings,snapshot:s,message:s.status==='failed'?'The saved attempt failed; no findings were invented and successful memory was not replaced.':'The saved paid domain research attempt was loaded. success, no_results, failed, unavailable, and skipped remain distinct.'}:{ok:false,error:{code:'PAID_RESEARCH_NOT_FOUND',message:String($json.error?.message??'No saved paid research attempt with that job ID belongs to this conversation.')}};return{json:{...input,response}};"
      },
