    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const merged = $('Validate And Merge').first().json;\nconst list = (value) => String(value ?? '').split(',').filter(Boolean);\n\nconst missing = [];\nif (list(merged.founderNames).length === 0) missing.push('who the founders are, by name');\nif (list(merged.customerNames).length === 0 && list(merged.customerDomains).length === 0) missing.push('the names or email domains of a few customers');\nif (list(merged.investorNames).length === 0 && list(merged.investorDomains).length === 0) missing.push('the names or email domains of any investors');\nif (list(merged.positiveKeywords).length === 0) missing.push('your product names or project codenames, so mail about them is picked up');\nif (!merged.oneLiner) missing.push('one line on what the company does');\n\nreturn [{ json: { ...merged, response: {\n  ok: true,\n  saved: true,\n  savedProfile: {\n    companyName: merged.companyName,\n    oneLiner: merged.oneLiner,\n    domainAliases: list(merged.domainAliases),\n    founderNames: list(merged.founderNames),\n    teamNames: list(merged.teamNames),\n    investorNames: list(merged.investorNames),\n    investorDomains: list(merged.investorDomains),\n    customerNames: list(merged.customerNames),\n    customerDomains: list(merged.customerDomains),\n    prospectNames: list(merged.prospectNames),\n    prospectDomains: list(merged.prospectDomains),\n    competitorNames: list(merged.competitorNames),\n    positiveKeywords: list(merged.positiveKeywords),\n    negativeKeywords: list(merged.negativeKeywords),\n    stage: merged.stage,\n    audience: merged.audience,\n    deliverTo: merged.deliverTo,\n  },\n  stillMissing: missing,\n  message: missing.length\n    ? 'Saved. Read the saved values back to the user so they can correct anything you misheard, then ask for the missing ones. Every name and domain here is a filter on which emails reach the update, so a thin profile produces a thin update.'\n    : 'Saved. Read the saved values back to the user so they can correct anything you misheard.'\n} } }];"
      },
