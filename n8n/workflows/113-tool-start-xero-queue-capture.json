{
  "name": "113 - TOOL - start_xero_queue_capture",
  "nodes": [
    {
      "parameters": {
        "content": "## Start a user-mediated Xero export\n\nQueues a bounded job for the local companion. The companion may open Xero, but it never reads the DOM, clicks Xero controls, or handles credentials. The user signs in, selects All bank accounts, and clicks Xero's built-in CSV Export once. A valid export automatically starts the read-only reconciliation review.",
        "height": 340,
        "width": 560,
        "color": 6
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -820,
        -300
      ],
      "id": "98000113-0000-4000-8000-000000000001",
      "name": "Sticky"
    },
    {
      "parameters": {
        "inputSource": "workflowInputs",
