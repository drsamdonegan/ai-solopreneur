# Optional local overrides. The learner setup works without a .env file.
# Copy this file to .env only if you need to change a value below.

# Browser-facing localhost ports.
CHAT_PORT=3000
N8N_PORT=5678
# Defaults to N8N_PORT + 1. Set this only when that internal port is unavailable.
# N8N_RUNNERS_BROKER_PORT=5679

# Internal document-reader port used only by the native local runner.
DOCUMENT_WORKER_PORT=3100

# Used by n8n when displaying and scheduling local dates.
# The local runner detects your system timezone automatically when unset.
GENERIC_TIMEZONE=Australia/Melbourne

# Optional fixed key for controlled backup/restore workflows. Normally n8n
# generates and stores its own private key inside the ignored data/ folder.
# Never commit a real value.
N8N_ENCRYPTION_KEY=replace-with-a-generated-64-character-secret

# Optional user-mediated Xero Uncoded Statement Lines export. It is disabled
# unless the hosted chat flag and an independent server-to-n8n control secret
# are both configured. Never reuse the Xero OAuth client secret here.
XERO_CAPTURE_RUNS_ENABLED=false
# XERO_CAPTURE_CONTROL_SECRET=replace-with-a-generated-32-character-secret

# The companion runs on the computer whose normal browser is signed into Xero.
# It opens only Xero's official report, watches Downloads for a new CSV, and
# never receives a Xero password, MFA code, cookie, or browser profile.
# XERO_EXPORT_CAPTURE_ENABLED=user-mediated-xero-export
# XERO_CAPTURE_N8N_URL=https://your-private-n8n.example
# XERO_CAPTURE_INGEST_SECRET=replace-with-a-different-generated-32-character-secret
# XERO_EXPORT_DAEMON=true
# XERO_EXPORT_INBOX_DIR=/absolute/path/to/a-custom-browser-download-folder
