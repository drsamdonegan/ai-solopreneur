        "language": "javaScript",
        "jsCode": "const sessionId=typeof $json.sessionId==='string'?$json.sessionId.trim():'',requestId=typeof $json.requestId==='string'?$json.requestId.trim():'',jobId=typeof $json.jobId==='string'?$json.jobId.trim():'',uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nlet error=null;if(!uuid.test(sessionId)||!uuid.test(requestId))error={code:'INVALID_SESSION',message:'The paid research lookup needs a valid conversation and request ID.'};else if(!/^paid-[a-z0-9-]{6,150}$/i.test(jobId))error={code:'INVALID_JOB_ID',message:'Use the exact paid research job ID returned when this conversation started the run.'};\nconst proposedInput={sessionId,requestId,jobId};return{json:{valid:error===null,...proposedInput,proposedInput,...(error?{response:{ok:false,error}}:{})}};"
      },
