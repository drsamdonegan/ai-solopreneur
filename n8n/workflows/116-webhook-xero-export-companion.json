    {
      "parameters": {
        "jsCode": "const b=$json.body??$json;const allowedKeys=new Set(['schema_version','run_id','companion_id','status','current','total','message','requires_user_login','bank_accounts_found','statement_lines_observed']);const states=new Set(['preflight','opening','awaiting_login','awaiting_export','discovering','capturing','verifying','uploading','reviewing','ready','failed','cancelled']);const exact=b&&typeof b==='object'&&!Array.isArray(b)&&Object.keys(b).every(k=>allowedKeys.has(k));const uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;const runId=String(b.run_id||''),companionId=String(b.companion_id||''),status=String(b.status||'');const current=Number(b.current||0),total=Number(b.total||0),accounts=Number(b.bank_accounts_found||0),lines=Number(b.statement_lines_observed||0);const valid=Boolean(exact&&b.schema_version===1&&uuid.test(runId)&&/^[A-Za-z0-9._:-]{8,128}$/.test(companionId)&&states.has(status)&&Number.isInteger(current)&&current>=0&&Number.isInteger(total)&&total>=current&&total<=20&&Number.isInteger(accounts)&&accounts>=0&&accounts<=100&&Number.isInteger(lines)&&lines>=0&&lines<=5000&&String(b.message||'').length<=500);return [{json:{valid,runId,companionId,status,phase:status,current,total,message:String(b.message||'').trim(),requiresUserLogin:b.requires_user_login===true?'yes':'no',accounts,lines,updatedAt:new Date().toISOString(),response:valid?undefined:{ok:false,error:{code:'INVALID_PROGRESS',message:'The companion progress envelope is invalid.'}}}}];"
