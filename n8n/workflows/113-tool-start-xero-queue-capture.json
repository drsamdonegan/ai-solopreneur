    {
      "parameters": {
        "jsCode": "const input=$('Decide Start').first().json;const note='The export helper is ready. Xero may open in your browser. Sign in and complete MFA yourself, choose Uncoded Statement Lines, select All bank accounts, and click CSV Export once. The helper never reads the page, clicks Xero controls, or sees credentials.';const run={runId:input.runId,source:input.source,state:'preflight',note,current:0,total:6,accountCount:0,capturedCount:0,expectedCount:0,createdAt:input.createdAt,updatedAt:input.updatedAt};return [{json:{...input,response:{ok:true,status:'started',run,runId:input.runId,progressUrl:input.progressUrl,manualLoginOnly:true,browserAutomation:false,automaticReview:true,period:input.period,message:note}}}];"
