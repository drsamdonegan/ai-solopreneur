      "id": "95630000-0000-4000-8000-000000000011",
      "name": "Read Existing Profile",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const input = $('Tool Input').first().json;\nconst existingRows = $input.all().map((item) => item.json).filter((row) => row && row.profileId === 'default');\nconst existing = existingRows[0] ?? {};\n\nconst sessionId = typeof input.sessionId === 'string' ? input.sessionId.trim() : '';\nconst requestId = typeof input.requestId === 'string' ? input.requestId.trim() : '';\nconst uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nlet error = null;\nif (!uuidPattern.test(sessionId) || !uuidPattern.test(requestId)) {\n  error = { code: 'INVALID_SESSION', message: 'Saving a company profile needs a valid conversation and request ID.' };\n}\n\nconst text = (value, limit) => {\n  const raw = typeof value === 'string' ? value.trim() : '';\n  return raw.slice(0, limit ?? 300);\n};\n\n// Names are matched case-insensitively against email text, so they are\n// stored lowercased and deduped. Anything under three characters is dropped:\n// a two-letter alias matches inside half the words in the English language\n// and would allowlist the entire inbox.\nconst nameList = (value, limit) => {\n  const parts = text(value, 1200)\n    .split(',')\n    .map((part) => part.trim().toLowerCase())\n    .filter((part) => part.length >= 3);\n  return Array.from(new Set(parts)).slice(0, limit ?? 30).join(',');\n};\n\n// Accepts anything a person might paste: https://www.acme.com/pricing,\n// sam@acme.com, or plain acme.com. Everything becomes the bare host.\nconst domainList = (value, limit) => {\n  const parts = text(value, 1200)\n    .split(',')\n    .map((part) => {\n      let raw = part.trim().toLowerCase();\n      if (!raw) return '';\n      if (raw.includes('@')) raw = raw.split('@').pop();\n      raw = raw.replace(/^https?:\\/\\//, '').replace(/^www\\./, '').split('/')[0].split('?')[0].trim();\n      return /^[a-z0-9.-]+\\.[a-z]{2,}$/.test(raw) ? raw : '';\n    })\n    .filter(Boolean);\n  return Array.from(new Set(parts)).slice(0, limit ?? 30).join(',');\n};\n\nconst STAGES = ['pre-seed', 'seed', 'series-a', 'revenue', 'unknown'];\nconst stage = (value) => {\n  const raw = text(value, 20).toLowerCase().replace(/\\s+/g, '-');\n  return STAGES.includes(raw) ? raw : '';\n};\n\nconst AUDIENCES = ['investor', 'team', 'community'];\nconst audience = (value) => {\n  const raw = text(value, 20).toLowerCase();\n  return AUDIENCES.includes(raw) ? raw : '';\n};\n\n// A blank field means 'not mentioned this time', never 'erase what I said before'.\nconst keep = (next, previous) => (next === '' || next === null ? (previous ?? '') : next);\n\nconst merged = {\n  companyName: keep(text(input.companyName, 120), existing.companyName),\n  oneLiner: keep(text(input.oneLiner, 300), existing.oneLiner),\n  domainAliases: keep(domainList(input.domainAliases, 10), existing.domainAliases),\n  founderNames: keep(nameList(input.founderNames, 12), existing.founderNames),\n  teamNames: keep(nameList(input.teamNames, 40), existing.teamNames),\n  investorNames: keep(nameList(input.investorNames, 40), existing.investorNames),\n  investorDomains: keep(domainList(input.investorDomains, 40), existing.investorDomains),\n  customerNames: keep(nameList(input.customerNames, 60), existing.customerNames),\n  customerDomains: keep(domainList(input.customerDomains, 60), existing.customerDomains),\n  prospectNames: keep(nameList(input.prospectNames, 60), existing.prospectNames),\n  prospectDomains: keep(domainList(input.prospectDomains, 60), existing.prospectDomains),\n  competitorNames: keep(nameList(input.competitorNames, 40), existing.competitorNames),\n  competitorDomains: keep(domainList(input.competitorDomains, 40), existing.competitorDomains),\n  positiveKeywords: keep(nameList(input.positiveKeywords, 40), existing.positiveKeywords),\n  negativeKeywords: keep(nameList(input.negativeKeywords, 40), existing.negativeKeywords),\n  stage: keep(stage(input.stage), existing.stage) || 'unknown',\n  voiceNotes: keep(text(input.voiceNotes, 800), existing.voiceNotes),\n  audience: keep(audience(input.audience), existing.audience) || 'team',\n  deliverTo: keep(text(input.deliverTo, 120), existing.deliverTo) || 'chat-only',\n};\n\nif (!error && !merged.companyName) {\n  error = { code: 'COMPANY_NAME_REQUIRED', message: 'Ask the user what the company is called before saving.' };\n}\n// The scan scores an email partly on whether the company's own domain is\n// among the participants. Without it, an inbox of real customer threads\n// scores identically to an inbox of newsletters.\nif (!error && !merged.domainAliases) {\n  error = { code: 'DOMAIN_REQUIRED', message: 'Ask the user for the company email domain, such as acme.com, before saving. Without it the email scan cannot tell company mail apart from everything else.' };\n}\n\nconst proposedInput = { sessionId, requestId, ...merged };\nif (error) {\n  return [{ json: { valid: false, sessionId, requestId, proposedInput, response: { ok: false, error } } }];\n}\n\nreturn [{ json: {\n  valid: true,\n  sessionId,\n  requestId,\n  proposedInput,\n  profileSavedAt: new Date().toISOString(),\n  ...merged,\n} }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
