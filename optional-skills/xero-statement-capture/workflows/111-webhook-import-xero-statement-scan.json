      "name": "Authenticated Scan",
      "webhookId": "98000111-0000-4000-8000-000000000115",
      "credentials": {
        "httpHeaderAuth": {
          "id": "phase20XeroCaptureBridge",
          "name": "Xero Capture Bridge"
