      "id": "97900101-0000-4000-8000-000000000013",
      "name": "Upsert Profile"
    },
    {
      "parameters": {
        "jsCode": "const merged = $('Validate And Merge').first().json;\n\nconst missing = [];\nif (!merged.neverGuessAbove) missing.push('the dollar amount above which you always want to decide yourself, rather than have a code suggested');\nif (!merged.accountCodeNotes) missing.push('any coding rules you already follow, in your own words, such as \"Uber is always 429 Travel\"');\nif (!merged.commonSuppliers) missing.push('the suppliers you pay regularly, and what each spend is for');\nif (!merged.financialYearEnd) missing.push('when your financial year ends');\n\nreturn [{ json: { ...merged, response: {\n  ok: true,\n  saved: true,\n  savedProfile: {\n    organisationName: merged.organisationName,\n    baseCurrency: merged.baseCurrency,\n    financialYearEnd: merged.financialYearEnd,\n    commonSuppliers: merged.commonSuppliers,\n    commonCustomers: merged.commonCustomers,\n    accountCodeNotes: merged.accountCodeNotes,\n    gstTreatmentNotes: merged.gstTreatmentNotes,\n    neverGuessAbove: merged.neverGuessAbove,\n  },\n  stillMissing: missing,\n  message: missing.length\n    ? 'Saved. Read the saved values back to the user so they can correct anything you misheard, then ask for the missing ones. These facts decide every suggestion a review makes, so a thin profile produces thin suggestions.'\n    : 'Saved. Read the saved values back to the user so they can correct anything you misheard.'\n} } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "id": "97900101-0000-4000-8000-000000000014",
