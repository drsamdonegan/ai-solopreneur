    {
      "parameters": {
        "jsCode": "const sessionId=String($json.sessionId||'').trim();\nconst requestId=String($json.requestId||'').trim();\nconst suppliedRunId=String($json.runId||'').trim();\nconst rawPeriod=String($json.period||'all').trim();\nconst source=String($json.source||'agent').trim()||'agent';\nconst readOnly=$json.readOnly!==false;\nconst uuid=/^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nlet error=null,period='all';\nif(!uuid.test(sessionId)||!uuid.test(requestId))error={code:'INVALID_SESSION',message:'Starting a Xero export needs a valid conversation and request ID.'};\nelse if(suppliedRunId&&!uuid.test(suppliedRunId))error={code:'INVALID_RUN_ID',message:'The supplied capture run ID is invalid.'};\nelse if(!new Set(['user','agent']).has(source))error={code:'INVALID_SOURCE',message:'Capture source must be user or agent.'};\nelse if(!readOnly)error={code:'READ_ONLY_REQUIRED',message:'Capture and review must be read-only.'};\nelse if(rawPeriod){if(rawPeriod==='all')period='all';else if(/^\\d{4}-(0[1-9]|1[0-2])$/.test(rawPeriod))period=rawPeriod;else if(/^\\d{1,3}d$/i.test(rawPeriod)&&Number(rawPeriod.slice(0,-1))>=1&&Number(rawPeriod.slice(0,-1))<=180)period=String(Number(rawPeriod.slice(0,-1)))+'d';else error={code:'INVALID_PERIOD',message:'Use all, one month like 2026-07, or up to 180 days like 90d.'};}\nconst newUuid=()=>{let s='';for(let i=0;i<32;i++)s+=Math.floor(Math.random()*16).toString(16);return s.slice(0,8)+'-'+s.slice(8,12)+'-4'+s.slice(13,16)+'-'+(['8','9','a','b'][Math.floor(Math.random()*4)])+s.slice(17,20)+'-'+s.slice(20,32);};\nconst now=new Date(),runId=suppliedRunId||newUuid();\nreturn [{json:{valid:!error,sessionId,requestId,period,runId,source,readOnly:true,createdAt:now.toISOString(),updatedAt:now.toISOString(),expiresAt:new Date(now.getTime()+60*60000).toISOString(),progressUrl:'/api/xero-capture/runs/'+encodeURIComponent(runId),proposedInput:{schemaVersion:1,runId,sessionId,requestId,source,readOnly:true,period},...(error?{response:{ok:false,error}}:{})}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -580,
        0
      ],
      "id": "98000113-0000-4000-8000-000000000011",
      "name": "Validate Start Input"
    },
    {
      "parameters": {
