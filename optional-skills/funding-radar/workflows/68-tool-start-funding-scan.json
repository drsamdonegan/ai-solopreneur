      "id": "95550000-0000-4000-8000-000000000014",
      "name": "Read Funding Profile",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const DEFAULTS = {\"entityType\":\"company\",\"country\":\"Australia\",\"region\":\"New South Wales\",\"city\":\"Sydney\",\"headcount\":3,\"annualRevenue\":400000,\"yearsTrading\":1,\"interests\":\"startup growth\"};\nconst decided = $('Decide Run').first().json;\nif (!decided.shouldQueue) return [{ json: decided }];\n\nconst profile = $input.all().map((item) => item.json).find((row) => row && row.profileId === 'default');\n\n// A saved profile is the owner's own words and is never overwritten here.\nif (profile && profile.country) {\n  let beats = [];\n  try { beats = JSON.parse(profile.beats ?? '[]'); } catch {}\n  return [{ json: { ...decided, needsProfile: false, assumptions: [], beatCount: Array.isArray(beats) ? beats.length : 0 } }];\n}\n\nconst assumptions = [\n  `a ${DEFAULTS.entityType}`,\n  `based in ${DEFAULTS.city}, ${DEFAULTS.region}`,\n  'between one and five people',\n  'turning over under $500k',\n  'at startup stage',\n];\n\nreturn [{ json: {\n  ...decided,\n  needsProfile: true,\n  assumptions,\n  ...DEFAULTS,\n  profileSavedAt: new Date().toISOString(),\n} }];"
      },
