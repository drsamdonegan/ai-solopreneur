# Optional local overrides. The learner setup works without a .env file.
# Copy this file to .env only if you need to change a value below.

# Browser-facing localhost ports.
CHAT_PORT=3000
N8N_PORT=5678

# Internal document-reader port used only by the native local runner.
DOCUMENT_WORKER_PORT=3100

# Used by n8n when displaying and scheduling local dates.
# The local runner detects your system timezone automatically when unset.
GENERIC_TIMEZONE=Australia/Melbourne

# Only used by the optional Docker Compose deployment path (compose.yaml).
# The local Node.js runner lets n8n generate and store its own private key
# inside the ignored data/ folder. Never commit a real value.
COMPOSE_PROJECT_NAME=ai-solopreneur
N8N_ENCRYPTION_KEY=replace-with-a-generated-64-character-secret
