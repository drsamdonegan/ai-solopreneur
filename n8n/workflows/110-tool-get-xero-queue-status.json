      "parameters": {
        "jsCode": "const sessionId=String($json.sessionId||'').trim();const requestId=String($json.requestId||'').trim();const p=/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;const bankAccountId=String($json.bankAccountId||'').trim();return [{json:{valid:p.test(sessionId)&&p.test(requestId),sessionId,requestId,bankAccountId,proposedInput:{sessionId,requestId,bankAccountId}}}];"
      },
